ent-OrganNeoDionaStomach = augmented stomach
    .desc = The diona's equivalent of a stomach, it reeks of asparagus and vinegar.
    .suffix = Neo-Diona
ent-OrganNeoDionaLungs = diona augmented lungs
    .desc = A spongy mess of slimy, leaf-like structures. Capable of breathing both carbon dioxide and oxygen.
    .suffix = Neo-Diona
ent-OrganNeoDionaStomachNymph = neo-diona nymph stomach
    .desc = Gross. This is hard to stomach.
    .suffix = Neo-Diona Nymph
ent-OrganNeoDionaNymphStomach = neo-diona nymph stomach
    .desc = Contains the stomach of a formerly fully-formed Neo-Diona. It doesn't taste any better for it.
    .suffix = Neo-Diona Nymph
ent-OrganNeoDionaLungsNymph = neo-diona nymph lungs
    .desc = Filters oxygen from an atmosphere, which is then sent into the bloodstream to be used as an electron carrier.
    .suffix = Neo-Diona Nymph
ent-OrganNeoDionaNymphLungs = neo-diona nymph lungs
    .desc = Contains the lungs of a formerly fully-formed Neo-Diona. Breathtaking.
    .suffix = Neo-Diona Nymph
ent-OrganNeoDionaTongue = { ent-OrganNeocyteTongue }
    .desc = { ent-OrganNeocyteTongue.desc }
    .suffix = Neo-Diona
